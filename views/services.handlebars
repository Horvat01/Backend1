<h1>Servicios</h1>

{{#if services}}

    {{#each services}}
        <article>
            <h2>{{name}}</h2>

            <p>{{description}}</p>

            <p>Categoría: {{category}}</p>

            <p>Duración: {{duration}} minutos</p>

            <p>Precio: ${{price}}</p>

            {{#if available}}
                <p>Disponibilidad: Disponible</p>
            {{else}}
                <p>Disponibilidad: No disponible</p>
            {{/if}}
        </article>
    {{/each}}

{{else}}

    <p class="error">No hay servicios disponibles.</p>

{{/if}}

