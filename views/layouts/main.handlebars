<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Servicios de Portones</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f6f9;
            color: #333;
        }

        head {
            display: block;
        }

        nav {
            background: #1e3a8a;
            padding: 16px;
            display: flex;
            justify-content: center;
            gap: 20px;
            box-shadow: 0 2px 6px rgba(0,0,0,.2);
        }

        nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            padding: 10px 18px;
            border-radius: 6px;
            transition: .3s;
        }

        nav a:hover {
            background: #2563eb;
        }

        main {
            width: 90%;
            max-width: 1100px;
            margin: 30px auto;
        }

        article {
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,.1);
        }

        .badge {
            display: inline-block;
            background: #22c55e;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: .8rem;
            font-weight: bold;
        }

        .error {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #ef4444;
            padding: 12px;
            border-radius: 8px;
            margin: 15px 0;
        }

        footer {
            margin-top: 40px;
            background: #1f2937;
            color: white;
            text-align: center;
            padding: 18px;
        }
    </style>
</head>

<body>

    <nav>
        <a href="/services">Servicios</a>
        <a href="/realtime-services">Servicios en Tiempo Real</a>
    </nav>

    <main>
        {{{body}}}
    </main>

    <footer>
        <p>Sistema Backend de Turnos y Reservas - 2026</p>
    </footer>

</body>

</html>